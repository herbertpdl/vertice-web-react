{
  "containerDefinitions": [
    {
      "name": "vertice-web",
      "image": "096571798756.dkr.ecr.us-east-2.amazonaws.com/vertice-web:0979e617d8a3",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "http",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "TRUSTED_PROXY_HOPS",
          "value": "2"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "HOSTNAME",
          "value": "0.0.0.0"
        },
        {
          "name": "BFF_URL",
          "value": "http://vertice-bff:3000"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vertice-web",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "web"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "node",
          "-e",
          "fetch('http://localhost:3000/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    }
  ],
  "family": "vertice-web",
  "executionRoleArn": "arn:aws:iam::096571798756:role/vertice-web-exec",
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
