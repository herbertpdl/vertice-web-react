# URL of the vertice-bff instance this app talks to. Server-side only (no
# NEXT_PUBLIC_ prefix) - the browser never calls the BFF directly, only this
# app's own /api routes, which proxy through using this value.
#
# vertice-bff also defaults to PORT=3000, so when running both locally start
# this app on a different port, e.g. `PORT=3100 npm run dev`.
BFF_URL=http://localhost:3000

# How many reverse proxies sit in front of this Next server and append to
# X-Forwarded-For (nginx, a load balancer, Vercel/Cloud Run's edge...). Default 0.
#
# Every server-side call to the BFF carries X-Forwarded-For with the browser's
# address, so the BFF's per-IP rate limits (login, register, password setup,
# the global bucket) see each user instead of this one server. The BFF only
# believes it from peers in its own TRUST_PROXY, which must therefore be set to
# this web server's address(es) - see vertice-bff's README.
#
# Next 16 gives route handlers no socket address: it fills X-Forwarded-For from
# the socket only when the request arrives without one. With 0 (local dev, or
# `next start` exposed directly) a browser that sends its own X-Forwarded-For
# picks the address it is rate-limited under. In production, put this server
# behind a proxy that appends the client address and set the hop count here.
# TRUSTED_PROXY_HOPS=1
